# GEMINI_API_KEY: Required for Gemini Live API and Gemini text models
# In Google AI Studio, this is automatically injected from user secrets.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

PORT=3000

# WEATHERSTACK_API_KEY: Optional/configurable for live weather data via Weatherstack API
WEATHERSTACK_API_KEY=YOUR_WEATHERSTACK_API_KEY
